# Copy this file to .env (git-ignored) and fill it in from your Xsolla account.
# The API key and webhook secret are server-side only: never put them in a browser or game client.

# The ID next to your project's name in Publisher Account (also in the address bar: /projects/<ID>).
XSOLLA_PROJECT_ID=

# Project settings > API keys > Create API key. Shown only once, when you create it.
XSOLLA_API_KEY=

# Project settings > Webhooks > Secret keys > Add key. Shown only once, when you create it.
XSOLLA_WEBHOOK_SECRET=

# The item the test store sells. npm run seed creates it.
XSOLLA_TEST_SKU=kit-demo-pass

# The port the kit listens on.
PORT=3000

# Optional: where the payment UI sends the player afterwards, e.g. your tunnel's https address.
# Leave it empty to use http://localhost:PORT, which works when you test on this machine.
# (The webhook address is set in Publisher Account, not here.)
PUBLIC_URL=
