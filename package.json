{
  "name": "xsolla-integration-kit",
  "version": "1.0.0",
  "private": true,
  "description": "A small Node.js reference for Xsolla payments: payment tokens, the sandbox payment UI, signed webhooks and exactly-once fulfilment, with a troubleshooting guide.",
  "license": "MIT",
  "author": "Aliff",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "seed": "node --env-file-if-exists=.env scripts/seed-items.js",
    "demo:empty-cart": "node --env-file-if-exists=.env scripts/demo-empty-cart.js",
    "demo:ids": "node scripts/demo-ids.js",
    "demo:webhooks": "node --env-file-if-exists=.env scripts/send-test-webhooks.js"
  }
}
